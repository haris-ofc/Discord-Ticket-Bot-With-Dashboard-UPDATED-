# ───────── Core ─────────
DISCORD_TOKEN=YOUR BOT TOKEN
GUILD_ID=1567774516162068592         # the ONE server this bot works in
EXTRA_GUILD_IDS=1567916241618866206
OWNER_IDS=1223566729955770429         # comma separated, can use owner-only commands
PREFIX=t.

# ───────── Dashboard (local only) ─────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=16897
DASHBOARD_PASSWORD=1414
SECRET_KEY=change-this-to-a-long-random-string
DATABASE_PATH=data/tickets.db

# ───────── Presence ─────────
# online | idle | dnd | invisible
PRESENCE_STATUS=idle
# playing | watching | listening | streaming | competing | custom | none
ACTIVITY_TYPE=watching
# Separate several texts with ;  (they rotate)
# Placeholders: {prefix} {tickets} {total} {members} {guild}
ACTIVITY_TEXT={tickets} open tickets;{prefix}help for commands
# Only used when ACTIVITY_TYPE=streaming (twitch/youtube url)
ACTIVITY_URL=https://twitch.tv/discord
# Seconds between rotations. 0 = don't rotate (first text only, refreshed every 10 min)
PRESENCE_ROTATE_SECONDS=420
